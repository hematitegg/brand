{
  "$description": "hematite design tokens, mirroring hematite/website as of 11 Nov 2026",
  "color": {
    "steel": { "$type": "color", "$value": "#C4D4E0", "$description": "Logo on dark; accents and glows" },
    "iron": { "$type": "color", "$value": "#2E3A46", "$description": "Logo on light" },
    "graphite": { "$type": "color", "$value": "#18181B", "$description": "Wordmark in the light two-tone logo (zinc-900)" },
    "haze": { "$type": "color", "$value": "#8A9BAB", "$description": "Secondary; favicons" },
    "night": { "$type": "color", "$value": "#09090B", "$description": "zinc-950, the ground" },
    "zinc": {
      "50": { "$type": "color", "$value": "#FAFAFA" },
      "100": { "$type": "color", "$value": "#F4F4F5" },
      "300": { "$type": "color", "$value": "#D4D4D8" },
      "400": { "$type": "color", "$value": "#A1A1AA" },
      "500": { "$type": "color", "$value": "#71717A" },
      "600": { "$type": "color", "$value": "#52525B" },
      "900": { "$type": "color", "$value": "#18181B" }
    },
    "surface": {
      "base": { "$type": "color", "$value": "rgba(255,255,255,0.02)" },
      "raised": { "$type": "color", "$value": "rgba(255,255,255,0.04)" },
      "ghost": { "$type": "color", "$value": "rgba(255,255,255,0.03)" }
    },
    "line": {
      "base": { "$type": "color", "$value": "rgba(255,255,255,0.06)" },
      "ghost": { "$type": "color", "$value": "rgba(255,255,255,0.08)" },
      "strong": { "$type": "color", "$value": "rgba(255,255,255,0.12)" }
    }
  },
  "radius": {
    "base": { "$type": "dimension", "$value": "10px" },
    "button": { "$type": "dimension", "$value": "12px" },
    "card": { "$type": "dimension", "$value": "16px" },
    "pill": { "$type": "dimension", "$value": "9999px" }
  },
  "shadow": {
    "glow-action": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "30px", "spread": "0px", "color": "rgba(196,212,224,0.25)" } },
    "glow-dot": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "0px", "blur": "6px", "spread": "0px", "color": "rgba(196,212,224,0.6)" } }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] },
    "hero": { "$type": "dimension", "$value": "36px → 60px", "$description": "text-4xl, sm:text-5xl, md:text-6xl; leading 1.1; bold; tracking -0.025em" },
    "section": { "$type": "dimension", "$value": "30px → 36px", "$description": "text-3xl, sm:text-4xl; bold; tracking -0.025em" },
    "body": { "$type": "dimension", "$value": "14px" }
  },
  "motion": {
    "ease-out-expo": { "$type": "cubicBezier", "$value": [0.22, 1, 0.36, 1] },
    "ease-out-quad": { "$type": "cubicBezier", "$value": [0.25, 0.46, 0.45, 0.94] },
    "spring-gentle": { "$value": { "stiffness": 280, "damping": 26 } },
    "spring-snappy": { "$value": { "stiffness": 420, "damping": 30 } },
    "spring-overlay": { "$value": { "stiffness": 340, "damping": 34 } },
    "stagger-app": { "$type": "duration", "$value": "60ms" },
    "stagger-landing": { "$type": "duration", "$value": "80ms" },
    "press-scale": { "$value": 0.97 }
  },
  "logo": {
    "emblem": "E2: two shards, edges on a 22.5° grid, cleft 45° then 67.5°, gap 7 units (11 below 48 px)",
    "wordmark": "Inter Display SemiBold Italic, tracking -22, cuts C2 light (45°, depth 45/1000 em), i-dot S6 at 1.22x",
    "colourways": {
      "color-dark": { "emblem": "#C4D4E0", "wordmark": "#FFFFFF", "i-dot": "#C4D4E0", "ground": "dark (default)" },
      "color": { "emblem": "#2E3A46", "wordmark": "#18181B", "i-dot": "#2E3A46", "ground": "light" },
      "steel": { "logo": "#C4D4E0", "ground": "dark" },
      "iron": { "logo": "#2E3A46", "ground": "light" },
      "black": { "logo": "#000000", "ground": "light, print" },
      "white": { "logo": "#FFFFFF", "ground": "photos, coloured" }
    }
  }
}
